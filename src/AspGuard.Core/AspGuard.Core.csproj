<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net8.0;net10.0</TargetFrameworks>
    <Description>Core of AspGuard without ASP.NET Core: detects N+1 queries and excessive query counts in EF Core applications at runtime, with the offending call site. Web applications should install the AspGuard package instead.</Description>
    <RootNamespace>AspGuard</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net462'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <!-- .NET Framework: the detection engine only; EF Core specific entry points are left out. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Text.Json" />
    <Compile Remove="AspGuardInterceptor.cs;EfDiagnosticsObserver.cs;Extensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspGuard.Core.Tests" />
    <InternalsVisibleTo Include="AspGuard" />
    <InternalsVisibleTo Include="AspGuard.Tests" />
    <InternalsVisibleTo Include="AspGuard.Benchmarks" />
    <InternalsVisibleTo Include="AspGuard.EntityFramework6" />
    <InternalsVisibleTo Include="AspGuard.SystemWeb" />
    <InternalsVisibleTo Include="AspGuard.Framework.Tests" />
  </ItemGroup>

</Project>

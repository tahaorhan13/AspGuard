<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code fixes live in their own assembly: analyzers must not reference Microsoft.CodeAnalysis.Workspaces (RS1038). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>AspGuard.Analyzers</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspGuard.Analyzers\AspGuard.Analyzers.csproj" />
  </ItemGroup>

</Project>
